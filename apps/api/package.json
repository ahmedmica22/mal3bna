{
  "name": "@court-booking/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "architecture:check": "vitest run src/architecture.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file=.env -r ts-node/register prisma/seed.ts",
    "admin:create": "pnpm build && node dist/cli/create-admin.js",
    "openapi:generate": "pnpm build && node dist/openapi/generate.js",
    "demo:m1": "node dist/demo/m1.js"
  },
  "dependencies": {
    "@court-booking/config": "workspace:*",
    "@court-booking/shared": "workspace:*",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-express": "^11.0.11",
    "@nestjs/swagger": "^12.0.4",
    "@prisma/client": "^6.7.0",
    "argon2": "^0.31.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "jose": "^6.1.0",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.0.11",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.21",
    "eslint": "^9.26.0",
    "prisma": "^6.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
