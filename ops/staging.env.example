NODE_ENV=staging
PORT=3000
API_PREFIX=api/v1
DATABASE_URL=postgresql://USER:PASSWORD@STAGING_DB_HOST:5432/court_booking?schema=public
MAILPIT_URL=
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME=Court Booking
JWT_ACCESS_SECRET=replace-with-staging-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-staging-secret-at-least-32-characters
WEB_ORIGIN=https://staging.example.com
LOG_LEVEL=info

# Provider acceptance is intentionally not populated locally.
KASHIER_MODE=sandbox
KASHIER_MERCHANT_ID=external-secret
KASHIER_API_KEY=external-secret
